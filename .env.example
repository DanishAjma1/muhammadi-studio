# ============================================================
# Muhammadi Studio — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Gmail SMTP Notification Configuration
# ------------------------------------------------------------
# To send real email notifications using your Gmail account:
#
# 1. Sign in to your Google Account (https://myaccount.google.com/)
# 2. Go to "Security" -> "2-Step Verification" (must be turned ON)
# 3. Scroll to the bottom and click on "App passwords"
#    (Or search "App passwords" in the top search bar)
# 4. Enter an App Name (e.g. "Muhammadi Studio") and click "Create"
# 5. Google will generate a 16-character code (e.g. "abcd efgh ijkl mnop")
# 6. Paste that code into GMAIL_APP_PASSWORD below (spaces are automatically stripped):

GMAIL_USER=contact@muhammadistudio.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Notification settings
NOTIFICATION_RECIPIENT=attiq@muhammadistudio.com
SMTP_FROM_NAME="Muhammadi Studio"

# Advanced SMTP settings (defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
